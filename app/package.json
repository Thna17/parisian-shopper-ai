{
  "name": "parisian-shopper-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room foundation for the Parisian Shopper AI Telegram Content System",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.22.2",
    "pnpm": "9.15.1"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "boundaries": "node scripts/check-boundaries.mjs",
    "boundaries:check": "pnpm boundaries",
    "db:generate": "pnpm --filter @parisian-shopper/database prisma:generate",
    "db:migrate": "pnpm --filter @parisian-shopper/database prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @parisian-shopper/database prisma:migrate:deploy",
    "db:migrate:status": "pnpm --filter @parisian-shopper/database prisma:migrate:status",
    "db:seed": "node --env-file=.env scripts/seed-demo-data.mjs",
    "user:enroll": "node --env-file=.env scripts/seed-demo-data.mjs",
    "demo": "node --env-file=.env scripts/interactive-demo.mjs --auto",
    "demo:interactive": "node --env-file=.env scripts/interactive-demo.mjs --interactive",
    "db:studio": "pnpm --filter @parisian-shopper/database prisma:studio",
    "dev": "pnpm --parallel --filter @parisian-shopper/api --filter @parisian-shopper/worker dev",
    "dev:api": "pnpm --filter @parisian-shopper/api dev",
    "dev:worker": "pnpm --filter @parisian-shopper/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "higgsfield:seedance": "node --env-file=.env.local --import tsx examples/higgsfield-seedance/index.ts",
    "license:check": "node scripts/check-licenses.mjs",
    "lint": "eslint . --max-warnings 0 && pnpm boundaries",
    "lint:fix": "eslint . --fix && prettier --write .",
    "outbox:status": "node scripts/outbox-operations.mjs --status",
    "prisma:validate": "pnpm --filter @parisian-shopper/database prisma:validate",
    "prisma:format": "pnpm --filter @parisian-shopper/database prisma:format",
    "queue:status": "node scripts/queue-operations.mjs --status",
    "backup:verify": "node scripts/verify-backup-restore.mjs",
    "security:audit": "pnpm audit --prod",
    "security:check": "pnpm security:audit",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "test:integration": "TESTCONTAINERS_RYUK_DISABLED=true node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.unit.config.cjs --runInBand",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.0.1",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "@higgsfield/client": "0.2.6"
  }
}
