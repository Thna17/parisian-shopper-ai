# Application
NODE_ENV=development
APP_NAME=parisian-shopper-ai
APP_HOST=127.0.0.1
APP_PORT=3000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
APP_BODY_LIMIT=1mb
APP_SWAGGER_ENABLED=true

# PostgreSQL (fictional local-development credentials only)
POSTGRES_USER=parisian
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=parisian_shopper
POSTGRES_PORT=5432
DATABASE_URL=postgresql://parisian:local_only_change_me@127.0.0.1:5432/parisian_shopper?schema=public

# Valkey
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PUBLISHED_PORT=6379
# VALKEY_PASSWORD=

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Optional future integration settings. Leave blank while the matching feature is disabled.
# TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
# TELEGRAM_WEBHOOK_URL=https://example.invalid/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
TELEGRAM_ACTION_TOKEN_TTL_SECONDS=900
# AI provider: fake | openai | deepseek | codex_cli
AI_PROVIDER=fake
# DeepSeek API (OpenAI-compatible, recommended for fast, cost-effective structured marketing content)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API (Optional alternative)
# OPENAI_API_KEY=
# AI_BASE_URL=
# OPENAI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
AI_ATTEMPT_STALE_AFTER_MS=35000
AI_MAX_RETRIES=2
AI_ALLOW_FAKE_IN_PRODUCTION=false
# Local Codex CLI runner (strictly private local development, prohibited in production)
# When AI_PROVIDER=codex_cli or CREATIVE_PROVIDER=codex_cli, local ChatGPT session is used.
CODEX_CLI_TEXT_TIMEOUT_MS=120000
CODEX_CLI_IMAGE_TIMEOUT_MS=300000
CODEX_CLI_MAX_CONCURRENCY=1
# RUN_CODEX_CLI_LIVE_TESTS=false

# Creative background provider: fake | openai | codex_cli
# When CREATIVE_PROVIDER=codex_cli, FEATURE_CREATIVE_GENERATION and FEATURE_AI_IMAGE_GENERATION must be true.
CREATIVE_PROVIDER=fake

# Higgsfield video provider. Keep credentials empty while disabled.
CREATIVE_VIDEO_PROVIDER=higgsfield
HIGGSFIELD_VIDEO_MODEL=bytedance/seedance-2.5/text-to-video
HIGGSFIELD_VIDEO_MAX_WAIT_MS=300000
HIGGSFIELD_GENERATE_AUDIO=false
HF_CREDENTIALS=
RUN_HIGGSFIELD_LIVE_TESTS=false
# Product API (Mekhla Auralis Trading)
# PRODUCT_API_BASE_URL=https://api.mekhla.digital
# PRODUCT_API_BUSINESS_ID=cmpwgnlpv0001li15e3n16uhc
# PRODUCT_API_CURRENCY=USD
# PRODUCT_API_ALLOWED_HOSTS=api.mekhla.digital
# PRODUCT_API_TIMEOUT_MS=3000
# PRODUCT_API_MAX_RETRIES=2
# RUN_PRODUCT_API_LIVE_TESTS=false
# PRODUCT_API_TOKEN=

# Feature flags: safe defaults for Phase 1A
FEATURE_AI_TEXT_GENERATION=false
FEATURE_AI_IMAGE_GENERATION=false
FEATURE_CREATIVE_GENERATION=false
FEATURE_HIGGSFIELD_PROVIDER=false
FEATURE_PRODUCT_IMAGE_TO_VIDEO=false
FEATURE_TELEGRAM=false
FEATURE_PRODUCT_API=false
FEATURE_AUTO_PUBLISHING=false
FEATURE_META_PUBLISHING=false
FEATURE_ANALYTICS=false

# Demo mode: prominent [DEMO] indicators in Telegram using deterministic fixtures
DEMO_MODE=false

# Persistent Post poster workflow (independent of CREATIVE_PROVIDER and Codex MCP)
POST_IMAGE_PROVIDER=disabled
# Server-side Higgsfield developer API credential. Never paste OAuth/MCP credentials here.
# HF_POSTER_API_KEY=
# Comma-separated exact HTTPS hostnames returned for developer API image outputs; no wildcards.
HF_POSTER_ASSET_HOSTS=
# Enable exactly one frozen request only AFTER presenting its quote, balance and references,
# obtaining explicit confirmation, and recording the administrator's confirmation via the API.
# POST_IMAGE_CONFIRMED_REQUEST_ID=<generation UUID>

# Direct business-owned Higgsfield MCP connection (separate from Codex OAuth and REST API keys).
# Generate a dedicated 32-byte random hex key in the server secret store; do not use this placeholder.
# HF_MCP_ENCRYPTION_KEY=
# Callback on the staff site's reverse proxy; HTTPS in production, loopback HTTP in development.
# HF_MCP_REDIRECT_URI=http://127.0.0.1:5173/v1/integrations/higgsfield-mcp/callback
# Optional preregistered OAuth application credentials when dynamic registration is unavailable.
# HF_MCP_CLIENT_ID=
# HF_MCP_CLIENT_SECRET=
# Must remain off until independent server OAuth and shared-use deployment support are verified.
HF_MCP_DISPATCH_ENABLED=false
HF_MCP_SHARED_USE_CONFIRMED=false

# Pre-registered confidential OAuth client authentication (otherwise dynamic public registration):
HF_MCP_CLIENT_AUTH_METHOD=client_secret_post

# Separate gate for real Post caption submissions; configure provider/approved brand/spending first.
POST_CAPTION_REAL_DISPATCH_ENABLED=false
