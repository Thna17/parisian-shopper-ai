  parentVersionId        String?  @map("parent_version_id") @db.Uuid
  aspectRatio            String   @map("aspect_ratio") @db.VarChar(20)
  width                  Int
  height                 Int
  templateId             String   @map("template_id") @db.VarChar(100)
  templateVersion        String   @map("template_version") @db.VarChar(50)
  stylePresetId          String?  @map("style_preset_id") @db.VarChar(100)
  language               String   @default("EN") @db.VarChar(20)
  safeMargins            Json     @map("safe_margins") @db.JsonB
  brandProfileVersionId  String   @map("brand_profile_version_id") @db.Uuid
  sourceContentVersionId String   @map("source_content_version_id") @db.Uuid
  productSnapshotId      String   @map("product_snapshot_id") @db.Uuid
  sceneHash              String   @map("scene_hash") @db.Char(64)
  dependencyHash         String   @map("dependency_hash") @db.Char(64)
  changeReason           String?  @map("change_reason") @db.VarChar(500)
  operationCode          String?  @map("operation_code") @db.VarChar(50)
  requestedByUserId      String?  @map("requested_by_user_id") @db.Uuid
  metadata               Json?    @db.JsonB
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  scene                CreativeScene            @relation(fields: [sceneId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "creative_scene_versions_scene_id_fkey")
  parentVersion        CreativeSceneVersion?    @relation("SceneVersionAncestry", fields: [parentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "creative_scene_versions_parent_version_id_fkey")
  childVersions        CreativeSceneVersion[]   @relation("SceneVersionAncestry")
  sourceContentVersion ContentVersion           @relation(fields: [sourceContentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "creative_scene_versions_content_version_id_fkey")
  productSnapshot      ProductSnapshot          @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "creative_scene_versions_product_snapshot_id_fkey")
  requestedByUser      User?                    @relation("UserRequestedSceneVersions", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "creative_scene_versions_requested_by_user_id_fkey")
  layers               SceneLayer[]
  dependencies         LayerDependency[]
  state                SceneVersionState?
  invalidationEvents   SceneInvalidationEvent[]

  @@unique([sceneId, versionNumber], map: "creative_scene_versions_scene_version_key")
  @@index([sceneId, createdAt], map: "creative_scene_versions_scene_created_at_idx")
  @@index([sceneHash], map: "creative_scene_versions_scene_hash_idx")
  @@index([dependencyHash], map: "creative_scene_versions_dependency_hash_idx")
  @@index([productSnapshotId], map: "creative_scene_versions_product_snapshot_id_idx")
  @@map("creative_scene_versions")
}

model SceneLayer {
  id                   String   @id @default(uuid()) @db.Uuid
  sceneVersionId       String   @map("scene_version_id") @db.Uuid
  layerKey             String   @map("layer_key") @db.VarChar(100)
  layerGroup           String   @map("layer_group") @db.VarChar(50)
  layerType            String   @map("layer_type") @db.VarChar(50)
  name                 String   @db.VarChar(255)
  zIndex               Int      @map("z_index")
  visible              Boolean  @default(true)
  opacity              Float    @default(1.0)
  blendMode            String   @default("NORMAL") @map("blend_mode") @db.VarChar(50)
  bounds               Json     @db.JsonB
  payload              Json     @db.JsonB
  payloadSchemaVersion Int      @default(1) @map("payload_schema_version")
  layerHash            String   @map("layer_hash") @db.Char(64)
  sortOrder            Int      @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sceneVersion CreativeSceneVersion @relation(fields: [sceneVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "scene_layers_scene_version_id_fkey")
  dependencies LayerDependency[]

  @@unique([id, sceneVersionId], map: "scene_layers_id_version_id_uniq")
  @@unique([sceneVersionId, layerKey], map: "scene_layers_version_key_uniq")
  @@unique([sceneVersionId, zIndex], map: "scene_layers_version_z_index_uniq")
  @@unique([sceneVersionId, sortOrder], map: "scene_layers_version_sort_order_uniq")
  @@index([sceneVersionId, sortOrder], map: "scene_layers_version_sort_idx")
  @@index([layerHash], map: "scene_layers_hash_idx")
  @@map("scene_layers")
}

model LayerDependency {
  id                   String   @id @default(uuid()) @db.Uuid
  sceneVersionId       String   @map("scene_version_id") @db.Uuid
  sceneLayerId         String?  @map("scene_layer_id") @db.Uuid
  dependencyType       String   @map("dependency_type") @db.VarChar(100)
  dependencyIdentifier String   @map("dependency_identifier") @db.VarChar(255)
  evidenceIdentifier   String?  @map("evidence_identifier") @db.VarChar(255)
  immutableDigest      String   @map("immutable_digest") @db.Char(64)
  sortOrder            Int      @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sceneVersion CreativeSceneVersion @relation(fields: [sceneVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "layer_dependencies_scene_version_id_fkey")
  sceneLayer   SceneLayer?          @relation(fields: [sceneLayerId, sceneVersionId], references: [id, sceneVersionId], onDelete: Restrict, onUpdate: Cascade, map: "layer_dependencies_layer_version_fkey")

  @@unique([sceneVersionId, dependencyType, dependencyIdentifier], map: "layer_deps_version_type_identifier_uniq")
  @@index([sceneVersionId, sortOrder], map: "layer_deps_version_sort_idx")
  @@index([immutableDigest], map: "layer_deps_digest_idx")
  @@map("layer_dependencies")
}

model SceneVersionState {
  id                 String    @id @default(uuid()) @db.Uuid
  sceneVersionId     String    @unique(map: "scene_version_states_scene_version_id_key") @map("scene_version_id") @db.Uuid
  status             String    @default("DRAFT") @db.VarChar(50)
  isExportEligible   Boolean   @default(false) @map("is_export_eligible")
  invalidationReason String?   @map("invalidation_reason") @db.VarChar(500)
  invalidatedAt      DateTime? @map("invalidated_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sceneVersion CreativeSceneVersion @relation(fields: [sceneVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "scene_version_states_scene_version_id_fkey")

  @@index([status], map: "scene_version_states_status_idx")
  @@map("scene_version_states")
}

model SceneInvalidationEvent {
  id                     String   @id @default(uuid()) @db.Uuid
  sceneVersionId         String   @map("scene_version_id") @db.Uuid
  reason                 String   @db.VarChar(500)
  divergedDependencyType String   @map("diverged_dependency_type") @db.VarChar(100)
  expectedDigest         String   @map("expected_digest") @db.Char(64)
  actualDigest           String   @map("actual_digest") @db.Char(64)
  recordedByUserId       String?  @map("recorded_by_user_id") @db.Uuid
  metadata               Json?    @db.JsonB
  recordedAt             DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  sceneVersion   CreativeSceneVersion @relation(fields: [sceneVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "scene_invalidation_events_scene_version_id_fkey")
  recordedByUser User?                @relation("UserRecordedSceneInvalidations", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "scene_invalidation_events_recorded_by_user_id_fkey")

  @@index([sceneVersionId, recordedAt], map: "scene_invalidation_events_version_recorded_at_idx")
  @@map("scene_invalidation_events")
}

enum ProductAssetRole {
  ORIGINAL_SOURCE
  HERO_CUTOUT
  PACKAGING_FRONT
  PACKAGING_BACK
  DETAIL
  SWATCH
  MASK
}

enum ProductAssetRightsState {
  UNKNOWN
  VERIFIED
  RESTRICTED
  EXPIRED
}

enum ProductAssetApprovalDecision {
  SUBMITTED
  APPROVED
  REJECTED
  RETIRED
}

enum ProductAssetTransformType {
  BACKGROUND_REMOVAL
  TRIM
  RESIZE
  COLOR_CORRECTION
  OPTIMIZATION
}

enum ProductAssetValidationStatus {
  PASS
  PASS_WITH_WARNINGS
  FAIL
}

model ProductAsset {
  id                String   @id @default(uuid()) @db.Uuid
  sha256            String   @unique(map: "product_assets_sha256_key") @db.Char(64)
  storageKey        String   @map("storage_key") @db.VarChar(300)
  mimeType          String   @map("mime_type") @db.VarChar(100)
  format            String   @db.VarChar(20)
  byteSize          Int      @map("byte_size")
  width             Int
  height            Int
  pixelCount        Int      @map("pixel_count")
  channels          Int
  hasAlpha          Boolean  @map("has_alpha")
  transparencyRatio Decimal  @map("transparency_ratio") @db.Decimal(5, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  registrations         ProductAssetRegistration[]
  validationAssessments ProductAssetValidationAssessment[]
  sourceTransforms      ProductAssetTransform[]            @relation("SourceProductAssetTransforms")
  derivedTransforms     ProductAssetTransform[]            @relation("DerivedProductAssetTransforms")

  @@index([createdAt], map: "product_assets_created_at_idx")
  @@index([mimeType], map: "product_assets_mime_type_idx")
  @@map("product_assets")
}

model ProductAssetRegistration {
  id                     String                  @id @default(uuid()) @db.Uuid
  sequence               BigInt                  @default(autoincrement())
  productAssetId         String                  @map("product_asset_id") @db.Uuid
  sku                    String                  @db.VarChar(64)
  productSnapshotId      String?                 @map("product_snapshot_id") @db.Uuid
  role                   ProductAssetRole
  sourceUrl              String?                 @map("source_url") @db.VarChar(2048)
  sourceSystem           String                  @map("source_system") @db.VarChar(100)
  sourceRecordId         String?                 @map("source_record_id") @db.VarChar(255)
  sourceImageId          String?                 @map("source_image_id") @db.VarChar(255)
  sourceRetrievedAt      DateTime?               @map("source_retrieved_at") @db.Timestamptz(3)
  sourceUrlHash          String?                 @map("source_url_hash") @db.Char(64)
  sourceEtag             String?                 @map("source_etag") @db.VarChar(255)
  sourceChecksum         String?                 @map("source_checksum") @db.VarChar(128)
  originSystem           String?                 @map("origin_system") @db.VarChar(100)
  correlationId          String?                 @map("correlation_id") @db.VarChar(128)
  replacesRegistrationId String?                 @map("replaces_registration_id") @db.Uuid
  rightsState            ProductAssetRightsState @default(UNKNOWN) @map("rights_state")
  rightsNotes            String?                 @map("rights_notes") @db.VarChar(1000)
  rightsExpiresAt        DateTime?               @map("rights_expires_at") @db.Timestamptz(3)
  metadata               Json?                   @db.JsonB
  registeredByUserId     String?                 @map("registered_by_user_id") @db.Uuid
  registeredAt           DateTime                @default(now()) @map("registered_at") @db.Timestamptz(3)

  productAsset         ProductAsset                @relation(fields: [productAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_registrations_product_asset_id_fkey")
  productSnapshot      ProductSnapshot?            @relation(fields: [productSnapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "product_asset_registrations_product_snapshot_id_fkey")
  registeredByUser     User?                       @relation("UserRegisteredProductAssets", fields: [registeredByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_registrations_registered_by_user_id_fkey")
  replacesRegistration ProductAssetRegistration?   @relation("RegistrationReplacements", fields: [replacesRegistrationId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "product_asset_registrations_replaces_fkey")
  replacedBy           ProductAssetRegistration[]  @relation("RegistrationReplacements")
  approvalEvents       ProductAssetApprovalEvent[]
  rightsEvents         ProductAssetRightsEvent[]

  @@index([sku, role, sequence], map: "product_asset_registrations_sku_role_seq_idx")
  @@index([sku, sequence], map: "product_asset_registrations_sku_seq_idx")
  @@index([productAssetId], map: "product_asset_registrations_asset_idx")
  @@index([rightsState], map: "product_asset_registrations_rights_state_idx")
  @@map("product_asset_registrations")
}

model ProductAssetValidationAssessment {
  id                String                       @id @default(uuid()) @db.Uuid
  sequence          BigInt                       @default(autoincrement())
  productAssetId    String                       @map("product_asset_id") @db.Uuid
  validatorVersion  String                       @map("validator_version") @db.VarChar(100)
  status            ProductAssetValidationStatus @default(PASS)
  isValid           Boolean                      @map("is_valid")
  format            String                       @db.VarChar(20)
  hasAlpha          Boolean                      @map("has_alpha")
  transparencyRatio Decimal                      @map("transparency_ratio") @db.Decimal(5, 4)
  width             Int
  height            Int
  byteSize          Int                          @map("byte_size")
  pixelCount        Int                          @map("pixel_count")
  findings          String[]                     @db.Text
  reasonCodes       String[]                     @map("reason_codes")
  assessedAt        DateTime                     @default(now()) @map("assessed_at") @db.Timestamptz(3)

  productAsset   ProductAsset                @relation(fields: [productAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_validation_assessments_asset_id_fkey")
  approvalEvents ProductAssetApprovalEvent[]
  transforms     ProductAssetTransform[]

  @@index([productAssetId, assessedAt, sequence], map: "product_asset_validation_assessments_asset_seq_idx")
  @@index([isValid], map: "product_asset_validation_assessments_valid_idx")
  @@index([status], map: "product_asset_validation_assessments_status_idx")
  @@map("product_asset_validation_assessments")
}

model ProductAssetApprovalEvent {
  id                         String                       @id @default(uuid()) @db.Uuid
  sequence                   BigInt                       @default(autoincrement())
  productAssetRegistrationId String                       @map("product_asset_registration_id") @db.Uuid
  decision                   ProductAssetApprovalDecision
  decidedByUserId            String?                      @map("decided_by_user_id") @db.Uuid
  reason                     String?                      @db.VarChar(200)
  notes                      String?                      @db.VarChar(1000)
  validationAssessmentId     String?                      @map("validation_assessment_id") @db.Uuid
  decidedAt                  DateTime                     @default(now()) @map("decided_at") @db.Timestamptz(3)

  registration         ProductAssetRegistration          @relation(fields: [productAssetRegistrationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_approval_events_registration_id_fkey")
  decidedByUser        User?                             @relation("UserProductAssetApprovalEvents", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_approval_events_decided_by_user_id_fkey")
  validationAssessment ProductAssetValidationAssessment? @relation(fields: [validationAssessmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_approval_events_validation_assessment_id_fkey")

  @@index([productAssetRegistrationId, sequence], map: "product_asset_approval_events_registration_seq_idx")
  @@index([decision, decidedAt, sequence], map: "product_asset_approval_events_decision_seq_idx")
  @@map("product_asset_approval_events")
}

model ProductAssetRightsEvent {
  id                         String                  @id @default(uuid()) @db.Uuid
  sequence                   BigInt                  @default(autoincrement())
  productAssetRegistrationId String                  @map("product_asset_registration_id") @db.Uuid
  rightsState                ProductAssetRightsState @map("rights_state")
  sourceReference            String?                 @map("source_reference") @db.VarChar(500)
  permittedScope             String?                 @map("permitted_scope") @db.VarChar(255)
  territory                  String?                 @map("territory") @db.VarChar(100)
  effectiveAt                DateTime                @default(now()) @map("effective_at") @db.Timestamptz(3)
  expiresAt                  DateTime?               @map("expires_at") @db.Timestamptz(3)
  verifiedByUserId           String?                 @map("verified_by_user_id") @db.Uuid
  reason                     String?                 @db.VarChar(500)
  notes                      String?                 @db.Text
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  registration   ProductAssetRegistration @relation(fields: [productAssetRegistrationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_rights_events_registration_id_fkey")
  verifiedByUser User?                    @relation("UserProductAssetRightsEvents", fields: [verifiedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_rights_events_verified_by_user_id_fkey")

  @@index([productAssetRegistrationId, effectiveAt, sequence], map: "product_asset_rights_events_reg_effective_seq_idx")
  @@index([rightsState, effectiveAt], map: "product_asset_rights_events_state_effective_idx")
  @@map("product_asset_rights_events")
}

model ProductAssetTransform {
  id                     String                    @id @default(uuid()) @db.Uuid
  sequence               BigInt                    @default(autoincrement())
  sourceAssetId          String                    @map("source_asset_id") @db.Uuid
  derivedAssetId         String                    @map("derived_asset_id") @db.Uuid
  transformType          ProductAssetTransformType @map("transform_type")
  toolName               String                    @default("sharp") @map("tool_name") @db.VarChar(100)
  toolVersion            String                    @default("1.0.0") @map("tool_version") @db.VarChar(100)
  parameters             Json                      @db.JsonB
  parametersSha256       String                    @map("parameters_sha256") @db.Char(64)
  validationAssessmentId String?                   @map("validation_assessment_id") @db.Uuid
  appliedByUserId        String?                   @map("applied_by_user_id") @db.Uuid
  appliedAt              DateTime                  @default(now()) @map("applied_at") @db.Timestamptz(3)

  sourceAsset          ProductAsset                      @relation("SourceProductAssetTransforms", fields: [sourceAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_transforms_source_asset_id_fkey")
  derivedAsset         ProductAsset                      @relation("DerivedProductAssetTransforms", fields: [derivedAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_transforms_derived_asset_id_fkey")
  appliedByUser        User?                             @relation("UserProductAssetTransforms", fields: [appliedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_transforms_applied_by_user_id_fkey")
  validationAssessment ProductAssetValidationAssessment? @relation(fields: [validationAssessmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_asset_transforms_validation_assessment_id_fkey")

  @@index([sourceAssetId], map: "product_asset_transforms_source_idx")
  @@index([derivedAssetId], map: "product_asset_transforms_derived_idx")
  @@map("product_asset_transforms")
}

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique(map: "campaigns_code_key") @db.VarChar(64)
  name        String         @db.VarChar(200)
  objective   String         @db.VarChar(500)
  description String?        @db.VarChar(2000)
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?      @map("start_date") @db.Timestamptz(3)
  endDate     DateTime?      @map("end_date") @db.Timestamptz(3)
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User              @relation("UserCreatedCampaigns", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "campaigns_created_by_id_fkey")
  products    CampaignProduct[]
  contentJobs ContentJob[]

  @@index([status, createdAt], map: "campaigns_status_created_at_idx")
  @@index([createdById, createdAt], map: "campaigns_created_by_created_at_idx")
  @@map("campaigns")
}

model CampaignProduct {
  id                    String   @id @default(uuid()) @db.Uuid
  campaignId            String   @map("campaign_id") @db.Uuid
  productSnapshotId     String   @map("product_snapshot_id") @db.Uuid
  sortOrder             Int      @default(0) @map("sort_order")
  isHero                Boolean  @default(false) @map("is_hero")
  notes                 String?  @db.VarChar(1000)
  targetPromoPrice      Decimal? @map("target_promo_price") @db.Decimal(10, 2)
  targetDiscountPercent Decimal? @map("target_discount_percent") @db.Decimal(5, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "campaign_products_campaign_id_fkey")
  productSnapshot ProductSnapshot @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "campaign_products_product_snapshot_id_fkey")

  @@unique([campaignId, productSnapshotId], map: "campaign_products_campaign_id_product_snapshot_id_key")
  @@index([campaignId, sortOrder], map: "campaign_products_campaign_id_sort_order_idx")
  @@map("campaign_products")
}

