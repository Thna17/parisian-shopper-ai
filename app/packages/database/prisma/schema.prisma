  @@index([productAssetId, assessedAt, sequence], map: "product_asset_validation_assessments_asset_seq_idx")
  @@index([isValid], map: "product_asset_validation_assessments_valid_idx")
  @@index([status], map: "product_asset_validation_assessments_status_idx")
  @@map("product_asset_validation_assessments")
}

model ProductAssetApprovalEvent {
