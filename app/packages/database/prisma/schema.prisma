generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStockStatus {
  in_stock
  low_stock
  out_of_stock
  preorder
  discontinued
  unknown
}

enum ProductLifecycleStatus {
  active
  discontinued
  deleted
}

enum FreshnessState {
  FRESH
  AGING
  STALE
  INVALID
  SOURCE_UNAVAILABLE
}

enum RevalidationOutcome {
  FRESH
  NON_MATERIAL_CHANGE
  MATERIAL_CHANGE
  SOURCE_UNAVAILABLE
  PROMOTION_EXPIRED
  OUT_OF_STOCK
}

enum SourceAvailability {
  AVAILABLE
  DEGRADED
  UNREACHABLE
}

enum PolicyLifecycleState {
  DRAFT
  APPROVED
  RETIRED
}

enum BrandRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ContentType {
  PRODUCT_SPOTLIGHT
  PROMOTION
  SCENT_PYRAMID
  EDUCATIONAL
  ENGAGEMENT
}

enum ContentLanguage {
  KM
  EN
  BILINGUAL
}

enum ContentPlatform {
  FACEBOOK
  INSTAGRAM
  TELEGRAM
  GENERIC
}

enum ContentJobStatus {
  REQUESTED
  GENERATING
  DRAFT
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  FAILED
}

enum RevisionRequestType {
  EDIT
  REGENERATE
}

enum RevisionRequestStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PendingReviewAction {
  EDIT
  REJECT
}

enum GenerationAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum ValidationSeverity {
  INFO
  WARNING
  BLOCKING
}

enum FactualValidationStatus {
  PASSED
  PASSED_WITH_WARNINGS
  BLOCKED
  FAILED
}

enum TelegramCreateFlowStatus {
  SELECTING_CONTENT_TYPE
  SELECTING_LANGUAGE
  SELECTING_PLATFORM
  SELECTING_TEMPLATE
  CONFIRMING_GENERATION
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TelegramNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum CreativeJobStatus {
  REQUESTED
  GENERATING_BACKGROUND
  COMPOSITING
  VALIDATING
  READY_FOR_REVIEW
  REVISION_REQUESTED
  CREATIVE_APPROVED
  CREATIVE_REJECTED
  FAILED
}

enum VisualAssetRole {
  CANONICAL_PRODUCT
  GENERATED_BACKGROUND
  COMPOSITED_CREATIVE
  PREVIEW
}

enum VisualValidationStatus {
  PASSED
  PASSED_WITH_WARNINGS
  BLOCKED
  FAILED
}

enum CreativeRevisionType {
  EDIT_BACKGROUND
  REGENERATE_BACKGROUND
  RETRY_FAILED
}

enum CreativeApprovalDecision {
  CREATIVE_APPROVED
  CREATIVE_REJECTED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  displayName String     @map("display_name") @db.VarChar(200)
  status      UserStatus @default(ACTIVE)
  disabledAt  DateTime?  @map("disabled_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                       UserRole[]                   @relation("UserRoles")
  roleAssignments             UserRole[]                   @relation("RoleAssignedBy")
  telegramIdentities          TelegramIdentity[]
  requestedContentJobs        ContentJob[]                 @relation("ContentJobRequester")
  revisionRequests            RevisionRequest[]            @relation("UserRevisionRequests")
  approvalEvents              ApprovalEvent[]
  auditEvents                 AuditEvent[]
  requestedCreativeJobs       CreativeJob[]                @relation("UserCreativeJobs")
  creativeRevisionRequests    CreativeRevisionRequest[]    @relation("UserCreativeRevisionRequests")
  creativeApprovalEvents      CreativeApprovalEvent[]      @relation("UserCreativeApprovalEvents")
  productFreshnessAssessments ProductFreshnessAssessment[]
  policyActivations           FreshnessPolicyActivation[]  @relation("PolicyActivatorUser")
  registeredProductAssets     ProductAssetRegistration[]   @relation("UserRegisteredProductAssets")
  productAssetApprovalEvents  ProductAssetApprovalEvent[]  @relation("UserProductAssetApprovalEvents")
  productAssetTransforms      ProductAssetTransform[]      @relation("UserProductAssetTransforms")
  productAssetRightsEvents    ProductAssetRightsEvent[]    @relation("UserProductAssetRightsEvents")
  requestedSceneVersions      CreativeSceneVersion[]       @relation("UserRequestedSceneVersions")
  recordedSceneInvalidations  SceneInvalidationEvent[]     @relation("UserRecordedSceneInvalidations")
  passwordCredential          PasswordCredential?
  sessions                    UserSession[]
  createdCampaigns            Campaign[]                   @relation("UserCreatedCampaigns")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "roles_code_key") @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_roles_user_id_fkey")
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_roles_role_id_fkey")
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_roles_assigned_by_id_fkey")

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedById], map: "user_roles_assigned_by_id_idx")
  @@map("user_roles")
}

model PasswordCredential {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  hashAlgorithm String    @default("argon2id") @map("hash_algorithm") @db.VarChar(32)
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "password_credentials_user_id_fkey")

  @@map("password_credentials")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique(map: "user_sessions_session_token_hash_key") @map("session_token_hash") @db.Char(64)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_sessions_user_id_fkey")

  @@index([sessionTokenHash, expiresAt, revokedAt], map: "user_sessions_token_active_idx")
  @@index([userId, revokedAt], map: "user_sessions_user_active_idx")
  @@map("user_sessions")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String    @db.VarChar(160)
  schemaVersion  Int       @default(1) @map("schema_version")
  idempotencyKey String    @unique(map: "outbox_events_idempotency_key_key") @map("idempotency_key") @db.VarChar(200)
  aggregateType  String?   @map("aggregate_type") @db.VarChar(100)
  aggregateId    String?   @map("aggregate_id") @db.VarChar(100)
  payload        Json      @db.JsonB
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  availableAt    DateTime  @map("available_at") @db.Timestamptz(3)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  telegramDeliveries TelegramNotificationDelivery[]

  @@index([processedAt, availableAt], map: "outbox_events_pending_idx")
  @@index([aggregateType, aggregateId, occurredAt], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

model ProductSnapshot {
  id                  String                 @id @default(uuid()) @db.Uuid
  sku                 String                 @db.VarChar(64)
  productName         String                 @map("product_name") @db.VarChar(300)
  brand               String                 @db.VarChar(120)
  category            String                 @db.VarChar(100)
  price               Decimal                @db.Decimal(19, 4)
  currency            String                 @db.Char(3)
  promoPrice          Decimal?               @map("promo_price") @db.Decimal(19, 4)
  discount            Json?                  @db.JsonB
  description         String?                @db.Text
  images              Json?                  @db.JsonB
  stockStatus         ProductStockStatus     @map("stock_status")
  productUrl          String?                @map("product_url") @db.VarChar(2048)
  fragranceNotes      Json?                  @map("fragrance_notes") @db.JsonB
  concentration       Json?                  @db.JsonB
  size                Json?                  @db.JsonB
  countryOfOrigin     Json?                  @map("country_of_origin") @db.JsonB
  similarityClaims    Json?                  @map("similarity_claims") @db.JsonB
  sourceSchemaVersion String                 @map("source_schema_version") @db.VarChar(20)
  sourceSystem        String                 @map("source_system") @db.VarChar(100)
  sourceRecordId      String?                @map("source_record_id") @db.VarChar(200)
  sourceVersion       String?                @map("source_version") @db.VarChar(200)
  sourceUpdatedAt     DateTime               @map("source_updated_at") @db.Timestamptz(3)
  retrievedAt         DateTime               @map("retrieved_at") @db.Timestamptz(3)
  sourceEtag          String?                @map("source_etag") @db.VarChar(500)
  lifecycleStatus     ProductLifecycleStatus @map("lifecycle_status")
  snapshotHash        String                 @map("snapshot_hash") @db.Char(64)
  catalogPriceHash    String?                @map("catalog_price_hash") @db.Char(64)
  campaignPriceHash   String?                @map("campaign_price_hash") @db.Char(64)
  stockHash           String?                @map("stock_hash") @db.Char(64)
  promotionHash       String?                @map("promotion_hash") @db.Char(64)
  permanentFactsHash  String?                @map("permanent_facts_hash") @db.Char(64)
  visualAssetHash     String?                @map("visual_asset_hash") @db.Char(64)
  normalizerVersion   String                 @map("normalizer_version") @db.VarChar(100)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  contentJobs               ContentJob[]
  contentVersions           ContentVersion[]
  creativeJobs              CreativeJob[]
  assessments               ProductFreshnessAssessment[] @relation("SnapshotAssessments")
  comparedAssessments       ProductFreshnessAssessment[] @relation("ComparedSnapshotAssessments")
  productAssetRegistrations ProductAssetRegistration[]
  sceneVersions             CreativeSceneVersion[]
  campaignProducts          CampaignProduct[]

  @@index([sku, createdAt], map: "product_snapshots_sku_created_at_idx")
  @@index([snapshotHash], map: "product_snapshots_snapshot_hash_idx")
  @@index([sourceSystem, sourceRecordId, sourceUpdatedAt], map: "product_snapshots_source_idx")
  @@map("product_snapshots")
}

model FreshnessPolicyVersion {
  id                            String   @id @default(uuid()) @db.Uuid
  policyId                      String   @map("policy_id") @db.VarChar(100)
  version                       String   @db.VarChar(50)
  stockTtlSeconds               Int      @map("stock_ttl_seconds")
  catalogPriceTtlSeconds        Int      @map("catalog_price_ttl_seconds")
  campaignPriceTtlSeconds       Int      @map("campaign_price_ttl_seconds")
  promotionTtlSeconds           Int      @map("promotion_ttl_seconds")
  promotionRecheckWindowSeconds Int      @map("promotion_recheck_window_seconds")
  permanentFactsTtlSeconds      Int      @map("permanent_facts_ttl_seconds")
  hardExpiryBoundarySeconds     Int      @map("hard_expiry_boundary_seconds")
  policyHash                    String   @map("policy_hash") @db.Char(64)
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activations FreshnessPolicyActivation[]

  @@unique([policyId, version], map: "freshness_policy_versions_policy_id_version_key")
  @@map("freshness_policy_versions")
}

model FreshnessPolicyActivation {
  id              String               @id @default(uuid()) @db.Uuid
  sequence        BigInt               @default(autoincrement())
  policyVersionId String               @map("policy_version_id") @db.Uuid
  environment     String               @db.VarChar(50)
  lifecycleState  PolicyLifecycleState @map("lifecycle_state")
  activatedAt     DateTime             @default(now()) @map("activated_at") @db.Timestamptz(3)
  activatedBy     String?              @map("activated_by") @db.Uuid

  policyVersion FreshnessPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "freshness_policy_activations_policy_version_id_fkey")
  activator     User?                  @relation("PolicyActivatorUser", fields: [activatedBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "freshness_policy_activations_activated_by_fkey")

  @@index([environment, activatedAt, sequence], map: "freshness_policy_activations_env_activated_seq_idx")
  @@index([environment, lifecycleState], map: "freshness_policy_activations_env_state_idx")
  @@map("freshness_policy_activations")
}

model ProductFreshnessAssessment {
  id                  String              @id @default(uuid()) @db.Uuid
  snapshotId          String              @map("snapshot_id") @db.Uuid
  evaluatedAt         DateTime            @map("evaluated_at") @db.Timestamptz(3)
  policyId            String              @map("policy_id") @db.VarChar(100)
  policyVersion       String              @map("policy_version") @db.VarChar(50)
  freshnessState      FreshnessState      @map("freshness_state")
  revalidationOutcome RevalidationOutcome @map("revalidation_outcome")
  sourceAvailability  SourceAvailability  @map("source_availability")
  reasonCodes         String[]            @map("reason_codes")
  evidence            Json                @db.JsonB
  comparedSnapshotId  String?             @map("compared_snapshot_id") @db.Uuid
  actorUserId         String?             @map("actor_user_id") @db.Uuid
  idempotencyKey      String?             @unique(map: "product_freshness_assessments_idempotency_key_key") @map("idempotency_key") @db.VarChar(200)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  snapshot         ProductSnapshot  @relation("SnapshotAssessments", fields: [snapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_freshness_assessments_snapshot_id_fkey")
  comparedSnapshot ProductSnapshot? @relation("ComparedSnapshotAssessments", fields: [comparedSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_freshness_assessments_compared_snapshot_id_fkey")
  actorUser        User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "product_freshness_assessments_actor_user_id_fkey")

  @@index([snapshotId, evaluatedAt], map: "product_freshness_assessments_snapshot_evaluated_idx")
  @@index([policyId, policyVersion], map: "product_freshness_assessments_policy_idx")
  @@map("product_freshness_assessments")
}

model BrandRuleVersion {
  id                String          @id @default(uuid()) @db.Uuid
  name              String          @db.VarChar(160)
  version           Int
  status            BrandRuleStatus
  languageRules     Json            @map("language_rules") @db.JsonB
  toneRules         Json            @map("tone_rules") @db.JsonB
  ctaRules          Json            @map("cta_rules") @db.JsonB
  promotionRules    Json            @map("promotion_rules") @db.JsonB
  perfumeClaimRules Json            @map("perfume_claim_rules") @db.JsonB
  platformRules     Json            @map("platform_rules") @db.JsonB
  visualGuidance    Json            @map("visual_guidance") @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt       DateTime?       @map("activated_at") @db.Timestamptz(3)

  contentJobs     ContentJob[]
  contentVersions ContentVersion[]
  creativeJobs    CreativeJob[]

  @@unique([name, version], map: "brand_rule_versions_name_version_key")
  @@index([status, createdAt], map: "brand_rule_versions_status_created_at_idx")
  @@map("brand_rule_versions")
}

model ContentJob {
  id                   String           @id @default(uuid()) @db.Uuid
  productSnapshotId    String           @map("product_snapshot_id") @db.Uuid
  brandRuleVersionId   String           @map("brand_rule_version_id") @db.Uuid
  requesterUserId      String           @map("requester_user_id") @db.Uuid
  campaignId           String?          @map("campaign_id") @db.Uuid
  telegramCreateFlowId String?          @unique(map: "content_jobs_telegram_create_flow_id_key") @map("telegram_create_flow_id") @db.Uuid
  contentType          ContentType      @map("content_type")
  language             ContentLanguage
  platform             ContentPlatform
  campaignContext      String?          @map("campaign_context") @db.VarChar(2000)
  status               ContentJobStatus @default(REQUESTED)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  productSnapshot           ProductSnapshot                    @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_product_snapshot_id_fkey")
  brandRuleVersion          BrandRuleVersion                   @relation(fields: [brandRuleVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_brand_rule_version_id_fkey")
  requester                 User                               @relation("ContentJobRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_requester_user_id_fkey")
  campaign                  Campaign?                          @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "content_jobs_campaign_id_fkey")
  telegramCreateFlow        TelegramCreateFlow?                @relation(fields: [telegramCreateFlowId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_telegram_create_flow_id_fkey")
  versions                  ContentVersion[]
  attempts                  GenerationAttempt[]
  revisionRequests          RevisionRequest[]                  @relation("ContentJobRevisionRequests")
  approvalEvents            ApprovalEvent[]
  pendingReviewInteractions TelegramPendingReviewInteraction[]

  @@index([status, createdAt], map: "content_jobs_status_created_at_idx")
  @@index([productSnapshotId, createdAt], map: "content_jobs_product_snapshot_id_created_at_idx")
  @@index([requesterUserId, createdAt], map: "content_jobs_requester_user_id_created_at_idx")
  @@index([campaignId], map: "content_jobs_campaign_id_idx")
  @@map("content_jobs")
}

model TelegramIdentity {
  id               String    @id @default(uuid()) @db.Uuid
  telegramUserId   BigInt    @unique(map: "telegram_identities_telegram_user_id_key") @map("telegram_user_id")
  userId           String    @map("user_id") @db.Uuid
  telegramUsername String?   @map("telegram_username") @db.VarChar(64)
  displayName      String?   @map("display_name") @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(3)

  user                      User                               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_identities_user_id_fkey")
  createFlows               TelegramCreateFlow[]
  actionTokens              TelegramActionToken[]
  notificationDeliveries    TelegramNotificationDelivery[]
  rateLimitBuckets          TelegramRateLimitBucket[]
  pendingReviewInteractions TelegramPendingReviewInteraction[]
  auditEvents               AuditEvent[]
  activeWorkflowMessages    TelegramActiveWorkflowMessage[]

  @@index([userId], map: "telegram_identities_user_id_idx")
  @@map("telegram_identities")
}

model InboundTelegramUpdate {
  id               String   @id @default(uuid()) @db.Uuid
  telegramUpdateId BigInt   @unique(map: "inbound_telegram_updates_update_id_key") @map("telegram_update_id")
  telegramUserId   BigInt?  @map("telegram_user_id")
  updateType       String   @map("update_type") @db.VarChar(40)
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt], map: "inbound_telegram_updates_received_at_idx")
  @@map("inbound_telegram_updates")
}

model TelegramCreateFlow {
  id                 String                   @id @default(uuid()) @db.Uuid
  telegramIdentityId String                   @map("telegram_identity_id") @db.Uuid
  productData        Json                     @map("product_data") @db.JsonB
  status             TelegramCreateFlowStatus @default(SELECTING_CONTENT_TYPE)
  contentType        ContentType?             @map("content_type")
  language           ContentLanguage?
  platform           ContentPlatform?
  expiresAt          DateTime                 @map("expires_at") @db.Timestamptz(3)
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  telegramIdentity TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_create_flows_identity_id_fkey")
  contentJob       ContentJob?

  @@index([telegramIdentityId, createdAt], map: "telegram_create_flows_identity_created_at_idx")
  @@index([status, expiresAt], map: "telegram_create_flows_status_expires_at_idx")
  @@map("telegram_create_flows")
}

model TelegramActionToken {
  id                 String    @id @default(uuid()) @db.Uuid
  tokenHash          String    @unique(map: "telegram_action_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  telegramIdentityId String    @map("telegram_identity_id") @db.Uuid
  action             String    @db.VarChar(80)
  resourceId         String    @map("resource_id") @db.VarChar(200)
  singleUse          Boolean   @default(true) @map("single_use")
  metadata           Json?     @db.JsonB
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  telegramIdentity TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_action_tokens_identity_id_fkey")

  @@index([telegramIdentityId, expiresAt], map: "telegram_action_tokens_identity_expires_at_idx")
  @@map("telegram_action_tokens")
}

model TelegramNotificationDelivery {
  id                 String                     @id @default(uuid()) @db.Uuid
  outboxEventId      String                     @unique(map: "telegram_notification_deliveries_outbox_event_id_key") @map("outbox_event_id") @db.Uuid
  telegramIdentityId String                     @map("telegram_identity_id") @db.Uuid
  status             TelegramNotificationStatus @default(PENDING)
  attemptCount       Int                        @default(0) @map("attempt_count")
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(100)
  sentAt             DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
