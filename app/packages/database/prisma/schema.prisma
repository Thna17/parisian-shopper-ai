model BrandProfileVersion {
  guidance Json? @db.JsonB
  guidanceRuleVersionId String? @map("guidance_rule_version_id") @db.Uuid
  guidanceDatasetVersionId String? @map("guidance_dataset_version_id") @db.Uuid
  businessApprovals BrandProfileApproval[]
  id                   String             @id @default(uuid()) @db.Uuid
  versionNumber        Int                @map("version_number")
  name                 String             @db.VarChar(160)
  status               BrandProfileStatus @default(DRAFT)
  evaluationPolicyId   String             @map("evaluation_policy_id") @db.VarChar(100)
  languagePolicy       Json               @map("language_policy") @db.JsonB
  toneRules            Json               @map("tone_rules") @db.JsonB
  visualAestheticRules Json               @map("visual_aesthetic_rules") @db.JsonB
  typographyRules      Json               @map("typography_rules") @db.JsonB
  logoRules            Json               @map("logo_rules") @db.JsonB
  approvedExampleIds   String[]           @map("approved_example_ids")
  prohibitedPatterns   String[]           @map("prohibited_patterns")
  benchmarkReport      Json?              @map("benchmark_report") @db.JsonB
  approvedByUserId     String             @map("approved_by_user_id") @db.Uuid
  activatedAt          DateTime?          @map("activated_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([name, versionNumber], map: "brand_profile_versions_name_version_key")
  @@index([status, createdAt], map: "brand_profile_versions_status_created_at_idx")
  @@map("brand_profile_versions")
}

model BrandSourceArchive {
  sourceUrl String? @map("source_url") @db.VarChar(2048)
  referenceGroupId String? @map("reference_group_id") @db.Uuid
  referenceVersion Int @default(1) @map("reference_version")
  reviewEvents BrandSourceReview[]
  id                   String            @id @default(uuid()) @db.Uuid
  sourceSystem         BrandSourceSystem @map("source_system")
  externalPostId       String?           @map("external_post_id") @db.VarChar(120)
  captionText          String            @map("caption_text") @db.Text
  sanitizedCaptionText String            @map("sanitized_caption_text") @db.Text
  copyrightDeclared    Boolean           @default(false) @map("copyright_declared")
  copyrightOwner       String            @map("copyright_owner") @db.VarChar(200)
  licenseReference     String            @map("license_reference") @db.VarChar(200)
  mediaCasKeys         String[]          @map("media_cas_keys")
  tags                 String[]          @default([])
  sha256Hex            String            @map("sha256_hex") @db.VarChar(64)
  ingestedByUserId     String            @map("ingested_by_user_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sourceSystem, createdAt], map: "brand_source_archives_system_created_at_idx")
  @@index([sha256Hex], map: "brand_source_archives_sha256_idx")
  @@unique([referenceGroupId,referenceVersion], map:"brand_reference_version_key")
  @@map("brand_source_archives")
}

model BrandDatasetVersion {
  sourceArchiveIds String[] @default([]) @map("source_archive_ids")
  id               String             @id @default(uuid()) @db.Uuid
  name             String             @db.VarChar(160)
  versionString    String             @unique @map("version_string") @db.VarChar(60)
  status           BrandDatasetStatus @default(CURATING)
  assetCount       Int                @default(0) @map("asset_count")
  gitCommitHash    String?            @map("git_commit_hash") @db.VarChar(64)
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  feedbackRecords BrandFeedbackRecord[]

  @@index([status, createdAt], map: "brand_dataset_versions_status_created_at_idx")
  @@map("brand_dataset_versions")
}

model BrandFeedbackRecord {
  id               String   @id @default(uuid()) @db.Uuid
  sourceType       String   @map("source_type") @db.VarChar(50)
  contentJobId     String?  @map("content_job_id") @db.Uuid
  contentVersionId String?  @map("content_version_id") @db.Uuid
  originalText     String   @map("original_text") @db.Text
  revisedText      String?  @map("revised_text") @db.Text
  decision         String   @db.VarChar(50)
  critiqueNotes    String?  @map("critique_notes") @db.Text
  toneFlags        String[] @map("tone_flags")
  reviewerUserId   String?  @map("reviewer_user_id") @db.Uuid
  datasetVersionId String?  @map("dataset_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  datasetVersion BrandDatasetVersion? @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "brand_feedback_records_dataset_version_id_fkey")

  @@index([decision, createdAt], map: "brand_feedback_records_decision_created_at_idx")
  @@index([datasetVersionId], map: "brand_feedback_records_dataset_version_id_idx")
  @@map("brand_feedback_records")
}

// Staff post aggregate. Revisions and events are append-only through the repository.
enum PostStatus {
  REJECTED
  DRAFT
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

model Post {
  captionAttempts PostCaptionAttempt[]
  requestKey      String?              @map("request_key") @db.VarChar(160)
  requestHash     String?              @map("request_hash") @db.Char(64)
  reviewRound     Int                  @default(0) @map("review_round")
  id              String               @id @default(uuid()) @db.Uuid
  creatorUserId   String               @map("creator_user_id") @db.Uuid
  status          PostStatus           @default(DRAFT)
  revisionNumber  Int                  @default(1) @map("revision_number")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator         User                 @relation("PostCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  revisions       PostRevision[]
  generations     PostGeneration[]
  events          PostEvent[]

  @@unique([creatorUserId, requestKey], map: "posts_creator_request_key")
  @@index([creatorUserId, updatedAt])
  @@index([status, updatedAt])
  @@map("posts")
}

model PostGeneration {
  estimatedCredits Decimal? @map("estimated_credits") @db.Decimal(19, 8)
  actualCredits    Decimal? @map("actual_credits") @db.Decimal(19, 8)
  creditQuote      Json?    @map("credit_quote") @db.JsonB

  authorization        Json?          @db.JsonB
  id                   String         @id @default(uuid()) @db.Uuid
  postId               String         @map("post_id") @db.Uuid
  sourceRevisionId     String         @unique @map("source_revision_id") @db.Uuid
  sourceRevisionNumber Int            @map("source_revision_number")
  status               String         @default("QUEUED") @db.VarChar(30)
  provider             String         @db.VarChar(30)
  model                String         @db.VarChar(100)
  settings             Json           @db.JsonB
  prompt               String         @db.Text
  references           Json           @db.JsonB
  caption              Json?          @db.JsonB
  provenance           Json?          @db.JsonB
  requestId            String?        @map("request_id") @db.VarChar(200)
  estimatedCostUsd     Decimal?       @map("estimated_cost_usd") @db.Decimal(19, 8)
  actualCostUsd        Decimal?       @map("actual_cost_usd") @db.Decimal(19, 8)
  backgroundKey        String?        @map("background_key") @db.Text
  imageKey             String?        @map("image_key") @db.Text
  imageSha256          String?        @map("image_sha256") @db.Char(64)
  error                String?        @db.Text
  claimToken           String?        @map("claim_token") @db.Uuid
  leaseUntil           DateTime?      @map("lease_until") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  post                 Post           @relation(fields: [postId], references: [id], onDelete: Restrict)
  sourceRevision       PostRevision   @relation("GenerationSource", fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  outputRevisions      PostRevision[] @relation("GenerationOutput")

  @@index([status, leaseUntil])
  @@map("post_generations")
}

model PostRevision {
  brandSnapshot Json? @map("brand_snapshot") @db.JsonB
  captionSourceAttempts PostCaptionAttempt[]  @relation("CaptionSource")
  captionGenerationId   String?               @map("caption_generation_id") @db.Uuid
  captionGeneration     PostCaptionAttempt?   @relation("CaptionResult", fields: [captionGenerationId], references: [id], onDelete: Restrict)
  captionProvenance     Json?                 @map("caption_provenance") @db.JsonB
  creationPlan          Json?                 @map("creation_plan") @db.JsonB
  campaignSnapshot      Json?                 @map("campaign_snapshot") @db.JsonB
  captionDraft          Json?                 @map("caption_draft") @db.JsonB
  captionValidation     Json?                 @map("caption_validation") @db.JsonB
  id                    String                @id @default(uuid()) @db.Uuid
  postId                String                @map("post_id") @db.Uuid
  revisionNumber        Int                   @map("revision_number")
  authorUserId          String                @map("author_user_id") @db.Uuid
  productSnapshotId     String                @map("product_snapshot_id") @db.Uuid
  campaignId            String?               @map("campaign_id") @db.Uuid
  brief                 String                @default("") @db.VarChar(2000)
  channel               ContentPlatform
  language              ContentLanguage
  generationId          String?               @map("generation_id") @db.Uuid
  generation            PostGeneration?       @relation("GenerationOutput", fields: [generationId], references: [id], onDelete: Restrict)
  requestedGeneration   PostGeneration?       @relation("GenerationSource")
  captionVersionId      String?               @map("caption_version_id") @db.Uuid
  posterVersionId       String?               @map("poster_version_id") @db.Uuid
  visualAssetId         String?               @map("visual_asset_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  post                  Post                  @relation(fields: [postId], references: [id], onDelete: Restrict)
  author                User                  @relation("PostAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  productSnapshot       ProductSnapshot       @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict)
  campaign              Campaign?             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  captionVersion        ContentVersion?       @relation(fields: [captionVersionId], references: [id], onDelete: Restrict)
  posterVersion         CreativeSceneVersion? @relation(fields: [posterVersionId], references: [id], onDelete: Restrict)
  visualAsset           VisualAsset?          @relation(fields: [visualAssetId], references: [id], onDelete: Restrict)
  events                PostEvent[]

  @@unique([postId, revisionNumber])
  @@map("post_revisions")
}

model PostEvent {
  validationSnapshot Json?        @map("validation_snapshot") @db.JsonB
  reviewRound        Int?         @map("review_round")
  id                 String       @id @default(uuid()) @db.Uuid
  postId             String       @map("post_id") @db.Uuid
  revisionId         String       @map("revision_id") @db.Uuid
  actorUserId        String       @map("actor_user_id") @db.Uuid
  action             String       @db.VarChar(50)
  comment            String?      @db.VarChar(1000)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  post               Post         @relation(fields: [postId], references: [id], onDelete: Restrict)
  revision           PostRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actor              User         @relation("PostActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt])
  @@map("post_events")
}

model HiggsfieldMcpConnection {
  id             String   @id @default("business") @db.VarChar(40)
  encryptedState String?  @map("encrypted_state") @db.Text
  status         String   @default("DISCONNECTED") @db.VarChar(30)
  epoch          Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("higgsfield_mcp_connections")
}

model HiggsfieldMcpAudit {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(60)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("higgsfield_mcp_audit")
}

model PostTelegramDelivery {
  outboxEventId      String           @map("outbox_event_id") @db.Uuid
  telegramIdentityId String           @map("telegram_identity_id") @db.Uuid
  sentAt             DateTime?        @map("sent_at") @db.Timestamptz(3)
  event              OutboxEvent      @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  identity           TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict)

  @@id([outboxEventId, telegramIdentityId])
  @@map("post_telegram_deliveries")
}

model PostCaptionBrandApproval {
  id                 String           @id @default(uuid()) @db.Uuid
  brandRuleVersionId String           @map("brand_rule_version_id") @db.Uuid
  rulesDigest        String           @map("rules_digest") @db.Char(64)
  rulesSnapshot      Json             @map("rules_snapshot") @db.JsonB
  approvedByUserId   String           @map("approved_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  brand              BrandRuleVersion @relation(fields: [brandRuleVersionId], references: [id], onDelete: Restrict)
  approver           User             @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([brandRuleVersionId, rulesDigest], map: "post_caption_brand_digest_key")
  @@map("post_caption_brand_approvals")
}

model PostCaptionAttempt {
  id                   String         @id @default(uuid()) @db.Uuid
  postId               String         @map("post_id") @db.Uuid
  sourceRevisionId     String         @unique @map("source_revision_id") @db.Uuid
  sourceRevisionNumber Int            @map("source_revision_number")
  requesterUserId      String         @map("requester_user_id") @db.Uuid
  brandRuleVersionId   String?        @map("brand_rule_version_id") @db.Uuid
  brandRuleDigest      String?        @map("brand_rule_digest") @db.Char(64)
  method               String         @db.VarChar(20)
  status               String         @default("QUEUED") @db.VarChar(30)
  provider             String         @db.VarChar(40)
  model                String         @db.VarChar(200)
  context              Json?
  output               Json?
  validation           Json?
  provenance           Json?
  providerRequestId    String?        @map("provider_request_id") @db.VarChar(200)
  error                String?        @db.Text
  deadline             DateTime       @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  post                 Post           @relation(fields: [postId], references: [id], onDelete: Restrict)
  sourceRevision       PostRevision   @relation("CaptionSource", fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  resultRevisions      PostRevision[] @relation("CaptionResult")

  @@index([postId, status])
  @@map("post_caption_attempts")
}

model BrandProfileApproval {
 id String @id @default(uuid()) @db.Uuid
 profileId String @map("profile_id") @db.Uuid
 digest String @db.Char(64)
 snapshot Json @db.JsonB
 actorUserId String @map("actor_user_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 actor User @relation(fields:[actorUserId],references:[id],onDelete:Restrict)
 profile BrandProfileVersion @relation(fields:[profileId],references:[id],onDelete:Restrict)
 @@unique([profileId,digest],map:"brand_profile_approval_digest_key")
 @@map("brand_profile_approvals")
}
model BrandSourceReview {
 id String @id @default(uuid()) @db.Uuid
 sourceId String @map("source_id") @db.Uuid
 sourceDigest String @map("source_digest") @db.Char(64)
 decision String @db.VarChar(20)
 notes String @db.VarChar(1000)
 mediaSnapshot Json @map("media_snapshot") @db.JsonB
 actorUserId String @map("actor_user_id") @db.Uuid
 sequence Int
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 actor User @relation(fields:[actorUserId],references:[id],onDelete:Restrict)
 source BrandSourceArchive @relation(fields:[sourceId],references:[id],onDelete:Restrict)
 @@unique([sourceId,sequence])
 @@map("brand_source_reviews")
}
