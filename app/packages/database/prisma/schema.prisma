generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStockStatus {
  in_stock
  low_stock
  out_of_stock
  preorder
  discontinued
  unknown
}

enum ProductLifecycleStatus {
  active
  discontinued
  deleted
}

enum BrandRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ContentType {
  PRODUCT_SPOTLIGHT
  PROMOTION
  SCENT_PYRAMID
  EDUCATIONAL
  ENGAGEMENT
}

enum ContentLanguage {
  KM
  EN
  BILINGUAL
}

enum ContentPlatform {
  FACEBOOK
  INSTAGRAM
  TELEGRAM
  GENERIC
}

enum ContentJobStatus {
  REQUESTED
  GENERATING
  DRAFT
  FAILED
}

enum GenerationAttemptStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum ValidationSeverity {
  INFO
  WARNING
  BLOCKING
}

enum FactualValidationStatus {
  PASSED
  PASSED_WITH_WARNINGS
  BLOCKED
  FAILED
}

enum TelegramCreateFlowStatus {
  SELECTING_CONTENT_TYPE
  SELECTING_LANGUAGE
  SELECTING_PLATFORM
  COMPLETED
  EXPIRED
}

enum TelegramNotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  displayName String     @map("display_name") @db.VarChar(200)
  status      UserStatus @default(ACTIVE)
  disabledAt  DateTime?  @map("disabled_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                UserRole[]         @relation("UserRoles")
  roleAssignments      UserRole[]         @relation("RoleAssignedBy")
  telegramIdentities   TelegramIdentity[]
  requestedContentJobs ContentJob[]       @relation("ContentJobRequester")
  auditEvents          AuditEvent[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "roles_code_key") @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_roles_user_id_fkey")
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_roles_role_id_fkey")
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "user_roles_assigned_by_id_fkey")

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedById], map: "user_roles_assigned_by_id_idx")
  @@map("user_roles")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  topic          String    @db.VarChar(160)
  schemaVersion  Int       @default(1) @map("schema_version")
  idempotencyKey String    @unique(map: "outbox_events_idempotency_key_key") @map("idempotency_key") @db.VarChar(200)
  aggregateType  String?   @map("aggregate_type") @db.VarChar(100)
  aggregateId    String?   @map("aggregate_id") @db.VarChar(100)
  payload        Json      @db.JsonB
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  availableAt    DateTime  @map("available_at") @db.Timestamptz(3)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  telegramDeliveries TelegramNotificationDelivery[]

  @@index([processedAt, availableAt], map: "outbox_events_pending_idx")
  @@index([aggregateType, aggregateId, occurredAt], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

model ProductSnapshot {
  id                  String                 @id @default(uuid()) @db.Uuid
  sku                 String                 @db.VarChar(64)
  productName         String                 @map("product_name") @db.VarChar(300)
  brand               String                 @db.VarChar(120)
  category            String                 @db.VarChar(100)
  price               Decimal                @db.Decimal(19, 4)
  currency            String                 @db.Char(3)
  promoPrice          Decimal?               @map("promo_price") @db.Decimal(19, 4)
  discount            Json?                  @db.JsonB
  description         String?                @db.Text
  images              Json?                  @db.JsonB
  stockStatus         ProductStockStatus     @map("stock_status")
  productUrl          String?                @map("product_url") @db.VarChar(2048)
  fragranceNotes      Json?                  @map("fragrance_notes") @db.JsonB
  concentration       Json?                  @db.JsonB
  size                Json?                  @db.JsonB
  countryOfOrigin     Json?                  @map("country_of_origin") @db.JsonB
  similarityClaims    Json?                  @map("similarity_claims") @db.JsonB
  sourceSchemaVersion String                 @map("source_schema_version") @db.VarChar(20)
  sourceSystem        String                 @map("source_system") @db.VarChar(100)
  sourceRecordId      String?                @map("source_record_id") @db.VarChar(200)
  sourceVersion       String?                @map("source_version") @db.VarChar(200)
  sourceUpdatedAt     DateTime               @map("source_updated_at") @db.Timestamptz(3)
  retrievedAt         DateTime               @map("retrieved_at") @db.Timestamptz(3)
  sourceEtag          String?                @map("source_etag") @db.VarChar(500)
  lifecycleStatus     ProductLifecycleStatus @map("lifecycle_status")
  snapshotHash        String                 @map("snapshot_hash") @db.Char(64)
  normalizerVersion   String                 @map("normalizer_version") @db.VarChar(100)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  contentJobs     ContentJob[]
  contentVersions ContentVersion[]

  @@index([sku, createdAt], map: "product_snapshots_sku_created_at_idx")
  @@index([snapshotHash], map: "product_snapshots_snapshot_hash_idx")
  @@index([sourceSystem, sourceRecordId, sourceUpdatedAt], map: "product_snapshots_source_idx")
  @@map("product_snapshots")
}

model BrandRuleVersion {
  id                String          @id @default(uuid()) @db.Uuid
  name              String          @db.VarChar(160)
  version           Int
  status            BrandRuleStatus
  languageRules     Json            @map("language_rules") @db.JsonB
  toneRules         Json            @map("tone_rules") @db.JsonB
  ctaRules          Json            @map("cta_rules") @db.JsonB
  promotionRules    Json            @map("promotion_rules") @db.JsonB
  perfumeClaimRules Json            @map("perfume_claim_rules") @db.JsonB
  platformRules     Json            @map("platform_rules") @db.JsonB
  visualGuidance    Json            @map("visual_guidance") @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  activatedAt       DateTime?       @map("activated_at") @db.Timestamptz(3)

  contentJobs     ContentJob[]
  contentVersions ContentVersion[]

  @@unique([name, version], map: "brand_rule_versions_name_version_key")
  @@index([status, createdAt], map: "brand_rule_versions_status_created_at_idx")
  @@map("brand_rule_versions")
}

model ContentJob {
  id                   String           @id @default(uuid()) @db.Uuid
  productSnapshotId    String           @map("product_snapshot_id") @db.Uuid
  brandRuleVersionId   String           @map("brand_rule_version_id") @db.Uuid
  requesterUserId      String           @map("requester_user_id") @db.Uuid
  telegramCreateFlowId String?          @unique(map: "content_jobs_telegram_create_flow_id_key") @map("telegram_create_flow_id") @db.Uuid
  contentType          ContentType      @map("content_type")
  language             ContentLanguage
  platform             ContentPlatform
  campaignContext      String?          @map("campaign_context") @db.VarChar(2000)
  status               ContentJobStatus @default(REQUESTED)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  productSnapshot    ProductSnapshot     @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_product_snapshot_id_fkey")
  brandRuleVersion   BrandRuleVersion    @relation(fields: [brandRuleVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_brand_rule_version_id_fkey")
  requester          User                @relation("ContentJobRequester", fields: [requesterUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_requester_user_id_fkey")
  telegramCreateFlow TelegramCreateFlow? @relation(fields: [telegramCreateFlowId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_jobs_telegram_create_flow_id_fkey")
  versions           ContentVersion[]
  attempts           GenerationAttempt[]

  @@index([status, createdAt], map: "content_jobs_status_created_at_idx")
  @@index([productSnapshotId, createdAt], map: "content_jobs_product_snapshot_id_created_at_idx")
  @@index([requesterUserId, createdAt], map: "content_jobs_requester_user_id_created_at_idx")
  @@map("content_jobs")
}

model TelegramIdentity {
  id               String    @id @default(uuid()) @db.Uuid
  telegramUserId   BigInt    @unique(map: "telegram_identities_telegram_user_id_key") @map("telegram_user_id")
  userId           String    @map("user_id") @db.Uuid
  telegramUsername String?   @map("telegram_username") @db.VarChar(64)
  displayName      String?   @map("display_name") @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(3)

  user                   User                           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_identities_user_id_fkey")
  createFlows            TelegramCreateFlow[]
  actionTokens           TelegramActionToken[]
  notificationDeliveries TelegramNotificationDelivery[]
  rateLimitBuckets       TelegramRateLimitBucket[]
  auditEvents            AuditEvent[]

  @@index([userId], map: "telegram_identities_user_id_idx")
  @@map("telegram_identities")
}

model InboundTelegramUpdate {
  id               String   @id @default(uuid()) @db.Uuid
  telegramUpdateId BigInt   @unique(map: "inbound_telegram_updates_update_id_key") @map("telegram_update_id")
  telegramUserId   BigInt?  @map("telegram_user_id")
  updateType       String   @map("update_type") @db.VarChar(40)
  receivedAt       DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([receivedAt], map: "inbound_telegram_updates_received_at_idx")
  @@map("inbound_telegram_updates")
}

model TelegramCreateFlow {
  id                 String                   @id @default(uuid()) @db.Uuid
  telegramIdentityId String                   @map("telegram_identity_id") @db.Uuid
  productData        Json                     @map("product_data") @db.JsonB
  status             TelegramCreateFlowStatus @default(SELECTING_CONTENT_TYPE)
  contentType        ContentType?             @map("content_type")
  language           ContentLanguage?
  platform           ContentPlatform?
  expiresAt          DateTime                 @map("expires_at") @db.Timestamptz(3)
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  telegramIdentity TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_create_flows_identity_id_fkey")
  contentJob       ContentJob?

  @@index([telegramIdentityId, createdAt], map: "telegram_create_flows_identity_created_at_idx")
  @@index([status, expiresAt], map: "telegram_create_flows_status_expires_at_idx")
  @@map("telegram_create_flows")
}

model TelegramActionToken {
  id                 String    @id @default(uuid()) @db.Uuid
  tokenHash          String    @unique(map: "telegram_action_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  telegramIdentityId String    @map("telegram_identity_id") @db.Uuid
  action             String    @db.VarChar(80)
  resourceId         String    @map("resource_id") @db.VarChar(200)
  singleUse          Boolean   @default(true) @map("single_use")
  metadata           Json?     @db.JsonB
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  telegramIdentity TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_action_tokens_identity_id_fkey")

  @@index([telegramIdentityId, expiresAt], map: "telegram_action_tokens_identity_expires_at_idx")
  @@map("telegram_action_tokens")
}

model TelegramNotificationDelivery {
  id                 String                     @id @default(uuid()) @db.Uuid
  outboxEventId      String                     @unique(map: "telegram_notification_deliveries_outbox_event_id_key") @map("outbox_event_id") @db.Uuid
  telegramIdentityId String                     @map("telegram_identity_id") @db.Uuid
  status             TelegramNotificationStatus @default(PENDING)
  attemptCount       Int                        @default(0) @map("attempt_count")
  lastErrorCode      String?                    @map("last_error_code") @db.VarChar(100)
  sentAt             DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  outboxEvent      OutboxEvent      @relation(fields: [outboxEventId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_notification_deliveries_outbox_event_id_fkey")
  telegramIdentity TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_notification_deliveries_identity_id_fkey")

  @@index([status, updatedAt], map: "telegram_notification_deliveries_status_updated_at_idx")
  @@map("telegram_notification_deliveries")
}

model TelegramRateLimitBucket {
  telegramIdentityId String   @map("telegram_identity_id") @db.Uuid
  action             String   @db.VarChar(80)
  windowStart        DateTime @map("window_start") @db.Timestamptz(3)
  count              Int      @default(0)

  telegramIdentity TelegramIdentity @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "telegram_rate_limit_buckets_identity_id_fkey")

  @@id([telegramIdentityId, action, windowStart], map: "telegram_rate_limit_buckets_pkey")
  @@map("telegram_rate_limit_buckets")
}

model AuditEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  telegramIdentityId String?  @map("telegram_identity_id") @db.Uuid
  action             String   @db.VarChar(120)
  resourceType       String?  @map("resource_type") @db.VarChar(100)
  resourceId         String?  @map("resource_id") @db.VarChar(200)
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser        User?             @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_events_actor_user_id_fkey")
  telegramIdentity TelegramIdentity? @relation(fields: [telegramIdentityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "audit_events_telegram_identity_id_fkey")

  @@index([actorUserId, createdAt], map: "audit_events_actor_user_id_created_at_idx")
  @@index([action, createdAt], map: "audit_events_action_created_at_idx")
  @@map("audit_events")
}

model GenerationAttempt {
  id               String                  @id @default(uuid()) @db.Uuid
  contentJobId     String                  @map("content_job_id") @db.Uuid
  attemptNumber    Int                     @map("attempt_number")
  provider         String                  @db.VarChar(100)
  model            String                  @db.VarChar(200)
  promptVersion    String                  @map("prompt_version") @db.VarChar(100)
  status           GenerationAttemptStatus @default(PENDING)
  startedAt        DateTime                @map("started_at") @db.Timestamptz(3)
  completedAt      DateTime?               @map("completed_at") @db.Timestamptz(3)
  latencyMs        Int?                    @map("latency_ms")
  inputTokenCount  Int?                    @map("input_token_count")
  outputTokenCount Int?                    @map("output_token_count")
  totalTokenCount  Int?                    @map("total_token_count")
  estimatedCost    Decimal?                @map("estimated_cost") @db.Decimal(19, 6)
  errorCode        String?                 @map("error_code") @db.VarChar(100)
  errorMetadata    Json?                   @map("error_metadata") @db.JsonB

  contentJob ContentJob      @relation(fields: [contentJobId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "generation_attempts_content_job_id_fkey")
  version    ContentVersion?

  @@unique([contentJobId, attemptNumber], map: "generation_attempts_job_attempt_key")
  @@index([status, startedAt], map: "generation_attempts_status_started_at_idx")
  @@map("generation_attempts")
}

model ContentVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  contentJobId        String   @map("content_job_id") @db.Uuid
  versionNumber       Int      @map("version_number")
  brandRuleVersionId  String   @map("brand_rule_version_id") @db.Uuid
  productSnapshotId   String   @map("product_snapshot_id") @db.Uuid
  generationAttemptId String   @unique(map: "content_versions_generation_attempt_id_key") @map("generation_attempt_id") @db.Uuid
  provider            String   @db.VarChar(100)
  model               String   @db.VarChar(200)
  promptVersion       String   @map("prompt_version") @db.VarChar(100)
  structuredOutput    Json     @map("structured_output") @db.JsonB
  providerMetadata    Json?    @map("provider_metadata") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contentJob        ContentJob         @relation(fields: [contentJobId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_versions_content_job_id_fkey")
  brandRuleVersion  BrandRuleVersion   @relation(fields: [brandRuleVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_versions_brand_rule_version_id_fkey")
  productSnapshot   ProductSnapshot    @relation(fields: [productSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_versions_product_snapshot_id_fkey")
  generationAttempt GenerationAttempt  @relation(fields: [generationAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "content_versions_generation_attempt_id_fkey")
  validationResults ValidationResult[]

  @@unique([contentJobId, versionNumber], map: "content_versions_job_version_key")
  @@index([productSnapshotId, createdAt], map: "content_versions_product_snapshot_id_created_at_idx")
  @@map("content_versions")
}

model ValidationResult {
  id               String                  @id @default(uuid()) @db.Uuid
  contentVersionId String                  @map("content_version_id") @db.Uuid
  validatorVersion String                  @map("validator_version") @db.VarChar(100)
  status           FactualValidationStatus
  findingCount     Int                     @map("finding_count")
  blockingCount    Int                     @map("blocking_count")
  warningCount     Int                     @map("warning_count")
  infoCount        Int                     @map("info_count")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  contentVersion ContentVersion      @relation(fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "validation_results_content_version_id_fkey")
  findings       ValidationFinding[]

  @@unique([contentVersionId, validatorVersion], map: "validation_results_version_validator_key")
  @@index([contentVersionId, createdAt], map: "validation_results_content_version_created_at_idx")
  @@map("validation_results")
}

model ValidationFinding {
  id                 String             @id @default(uuid()) @db.Uuid
  validationResultId String             @map("validation_result_id") @db.Uuid
  field              String             @db.VarChar(100)
  severity           ValidationSeverity
  code               String             @db.VarChar(100)
  message            String             @db.VarChar(1000)
  expectedValue      Json?              @map("expected_value") @db.JsonB
  actualValue        Json?              @map("actual_value") @db.JsonB
  sourcePath         String?            @map("source_path") @db.VarChar(300)
  contentPath        String?            @map("content_path") @db.VarChar(300)
  metadata           Json?              @db.JsonB
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  validationResult ValidationResult @relation(fields: [validationResultId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "validation_findings_validation_result_id_fkey")

  @@index([validationResultId, severity], map: "validation_findings_result_severity_idx")
  @@index([code], map: "validation_findings_code_idx")
  @@map("validation_findings")
}
